{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "core",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@surge-media/core",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "core-start",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@surge-media/core",
        "start"
      ],
      "port": 3000
    },
    {
      "name": "playground",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@surge-media/playground",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "website",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@surge-media/website",
        "dev"
      ],
      "port": 4321
    },
    {
      "name": "core-start-3100",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "--env-file-if-exists=.env",
        "-e",
        "process.env.PORT = '3100'; import('./.output/server/index.mjs')"
      ],
      "cwd": "apps/core",
      "port": 3100
    }
  ]
}
