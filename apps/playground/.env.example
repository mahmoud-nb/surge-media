# Bac à sable des bibliothèques front : copier en .env.local (ignoré par git) et compléter.
# Adresse du core local (pnpm dev).
SURGE_BASE_URL=http://localhost:3000
# Projet de test : identifiant (fiche du projet), liste publique activée, origine http://localhost:5173 autorisée.
SURGE_PROJECT_ID=
# Clé publique du projet (sm_pk_…).
SURGE_PUBLISHABLE_KEY=
# Clé secrète du projet (sm_sk_…) : lue par le serveur Vite seulement, pour émettre des jetons délégués.
SURGE_SECRET_KEY=
