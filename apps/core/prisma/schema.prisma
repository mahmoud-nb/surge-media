// surgeMedia — schéma de la base de données
//
// Ce schéma doit rester PORTABLE entre SQLite, PostgreSQL et MySQL/MariaDB :
//   - le `provider` du bloc `datasource` est réécrit par `surge-media init` et
//     `surge-media db reset` : ne pas le modifier à la main ;
//   - pas d'attributs natifs `@db.*` (non supportés par SQLite) ;
//   - pas de listes scalaires `String[]` (non supportées par SQLite et MySQL) ;
//   - sous MySQL, `String` devient VARCHAR(191) : les longueurs maximales sont
//     validées par la couche API ;
//   - toute modification doit être suivie de `pnpm db:migration <nom>` pour
//     générer la migration de CHAQUE fournisseur.
//
// Prisma 7 : l'URL de connexion n'est plus déclarée ici mais dans
// `prisma.config.ts` (variable d'environnement DATABASE_URL).

generator client {
  provider     = "prisma-client"
  output       = "../server/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "sqlite"
}

// ─── Utilisateurs & sessions (interface d'administration) ────────────────────

/// Rôle de plateforme ; il encadre aussi le rôle dans chaque projet (shared/utils/permissions.ts)
enum Role {
  ADMIN // tous les privilèges : utilisateurs, tous les projets, gestion de la bibliothèque, réglages
  MANAGER // création de projets ; propriétaire des projets dont il est membre ; invitations (développeurs, éditeurs)
  DEVELOPER // projets dont il est membre (clés d'API, CORS, médias) ; bibliothèque en lecture
  EDITOR // médias des projets dont il est membre ; bibliothèque en lecture
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String?
  /// Empreinte du mot de passe ; null tant qu'un utilisateur invité ne l'a pas défini
  passwordHash String?
  /// Détail des permissions de chaque rôle : shared/utils/permissions.ts
  role         Role      @default(EDITOR)
  /// Langue de l'interface d'administration (code BCP 47 : "fr", "en"…)
  locale       String    @default("fr")
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  /// Compte qui a créé (invité) celui-ci ; un gestionnaire suit ainsi ses invitations
  invitedById  String?
  /// Double authentification (TOTP) : secret chiffré (v1.<iv>.<tag>.<données>, server/lib/mfa/secret-box.ts) ;
  /// null = inactive
  mfaSecret    String?
  mfaEnabledAt DateTime?
  /// Dernier pas TOTP accepté : un code déjà utilisé est refusé (anti-rejeu)
  mfaLastStep  Int?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  invitedBy            User?           @relation("UserInvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)
  invitedUsers         User[]          @relation("UserInvitedBy")
  sessions             Session[]
  projectMemberships   ProjectMember[]
  createdProjects      Project[]       @relation("ProjectCreatedBy")
  uploadedMedia        Media[]         @relation("MediaUploadedBy")
  personalTokens       AccessToken[]   @relation("AccessTokenOwner")
  createdAccessTokens  AccessToken[]   @relation("AccessTokenCreatedBy")
  passwordTokens       PasswordToken[] @relation("PasswordTokenUser")
  issuedPasswordTokens PasswordToken[] @relation("PasswordTokenCreatedBy")
  trustedDevices       TrustedDevice[]
  mfaRecoveryCodes     MfaRecoveryCode[]

  @@index([invitedById])
}

/// Code de secours de la double authentification : empreinte SHA-256, usage unique
/// (server/lib/mfa/recovery-codes.ts). Remplacés en bloc à chaque régénération.
model MfaRecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String    @unique
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Appareil de confiance (« mode sudo ») : jusqu'à son échéance, les actions sensibles ne redemandent pas le
/// mot de passe dans ce navigateur. Le jeton vit dans un cookie HTTP-only ; seule son empreinte est stockée.
/// Ne remplace la connexion que pour le second facteur, et seulement s'il a été approuvé juste après lui
/// (`secondFactorAt`) : le mot de passe reste toujours demandé (server/utils/trusted-devices.ts).
model TrustedDevice {
  id             String    @id @default(cuid())
  userId         String
  /// Empreinte SHA-256 du jeton du cookie
  tokenHash      String    @unique
  ipAddress      String?
  userAgent      String?
  expiresAt      DateTime
  /// Dernière action sensible autorisée par cet appareil (mise à jour au plus toutes les 5 minutes)
  lastUsedAt     DateTime  @default(now())
  /// Approuvé à l'étape du code de la connexion : dispense alors du code TOTP jusqu'à son échéance
  secondFactorAt DateTime?
  createdAt      DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Session {
  id                 String   @id @default(cuid())
  userId             String
  /// Empreinte SHA-256 du jeton de session (le jeton en clair n'est jamais stocké)
  tokenHash          String   @unique
  ipAddress          String?
  /// Tronqué à 191 caractères par l'API
  userAgent          String?
  expiresAt          DateTime
  createdAt          DateTime @default(now())
  lastSeenAt         DateTime @default(now())
  /// Dernière saisie du mot de passe (connexion ou confirmation) : actions sensibles (« mode sudo »)
  passwordVerifiedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

enum PasswordTokenPurpose {
  INVITATION // premier mot de passe d'un compte créé par un administrateur
  RESET // réinitialisation d'un mot de passe existant
}

/// Lien à usage unique pour définir (invitation) ou réinitialiser un mot de passe.
/// Généré par un administrateur, qui le transmet lui-même (pas d'envoi d'e-mail à ce stade).
model PasswordToken {
  id          String               @id @default(cuid())
  userId      String
  purpose     PasswordTokenPurpose
  /// Empreinte SHA-256 du jeton ; le lien en clair n'est affiché qu'une fois, à sa création
  tokenHash   String               @unique
  expiresAt   DateTime
  /// Date d'utilisation ; un jeton utilisé n'est plus valable (conservé pour l'historique)
  usedAt      DateTime?
  createdById String?
  createdAt   DateTime             @default(now())

  user      User  @relation("PasswordTokenUser", fields: [userId], references: [id], onDelete: Cascade)
  createdBy User? @relation("PasswordTokenCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([userId])
}

// ─── Projets, jetons d'accès API & CORS ──────────────────────────────────────

/// Rôle d'un membre dans un projet, plafonné par son rôle de plateforme (shared/utils/permissions.ts)
enum ProjectRole {
  OWNER // tout le projet : réglages, membres, clés d'API, origines, médias
  DEVELOPER // clés d'API, origines CORS et médias
  EDITOR // médias
}

/// Application cliente (et ses environnements) : ses médias, dossiers, membres, jetons et origines
model Project {
  id              String          @id @default(cuid())
  name            String
  /// Identifiant lisible (minuscules, chiffres, tirets), unique dans l'installation
  slug            String          @unique
  description     String?
  /// Projet archivé : lecture seule, clés d'API refusées ; étape préalable à la suppression
  archivedAt      DateTime?
  /// Liste publique : la clé publique peut lister et chercher les médias publics (sinon : lecture par identifiants)
  publicListing   Boolean         @default(false)
  /// Transformations libres de ses médias par URL (/m/…) : ouvertes, signées, ou préréglages seulement
  transformPolicy TransformPolicy @default(OPEN)
  createdById     String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  createdBy        User?                @relation("ProjectCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  members          ProjectMember[]
  media            Media[]
  folders          Folder[]
  /// Clés d'API du projet (publiques et secrètes)
  accessTokens     AccessToken[]
  /// Jetons personnels limités à une sélection de projets qui inclut celui-ci
  tokenGrants      AccessTokenProject[]
  allowedOrigins   AllowedOrigin[]
  /// Préréglages de transformation propres au projet
  transformPresets TransformPreset[]
  /// Étiquettes propres au projet (les globales ont projectId null)
  tags             Tag[]
}

/// Politique des transformations libres (paramètres dans l'URL) d'un espace ; les préréglages sont
/// toujours servis. La bibliothèque suit le réglage de l'installation (Setting « transforms.libraryPolicy »).
enum TransformPolicy {
  OPEN // paramètres libres acceptés, dans les bornes et quotas de l'installation
  SIGNED // paramètres libres seulement avec une URL signée (ou un identifiant d'API)
  PRESETS // préréglages seulement
}

/// Préréglage de transformation (/m/<id>/v<n>/<nom>/<fichier>.<format>) : global (projectId null) ou
/// propre à un projet, qui peut masquer un global du même nom. Unicité des noms par niveau : application.
model TransformPreset {
  id             String   @id @default(cuid())
  /// Projet du préréglage ; null = préréglage global (toute l'installation, bibliothèque comprise)
  projectId      String?
  /// ^[a-z][a-z0-9-]{0,31}$, hors noms réservés (shared/utils/transforms.ts)
  name           String
  /// Transformation canonique, sans format (ex. « w_800,h_450,q_70 »)
  transformation String
  description    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

/// Réglage de l'installation (clé-valeur), ex. « transforms.libraryPolicy »
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

/// Membre d'un projet (les ADMIN accèdent à tous les projets sans en être membres)
model ProjectMember {
  projectId String
  userId    String
  role      ProjectRole
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@index([userId])
}

enum TokenType {
  PERSONAL // jeton personnel (sm_pat_) : agit avec les droits de son propriétaire, sur les projets choisis
  SECRET // clé secrète de projet (sm_sk_) : serveurs du client, jamais dans un navigateur
  PUBLISHABLE // clé publique de projet (sm_pk_) : lecture des médias publics depuis un frontend
}

/// Identifiant d'API opaque : jeton personnel, clé secrète ou clé publique d'un projet.
/// Seule l'empreinte est stockée (sauf pour la clé publique, non secrète) ; les portées sont immuables.
model AccessToken {
  id             String    @id @default(cuid())
  type           TokenType
  name           String
  /// Projet d'une clé (SECRET, PUBLISHABLE) ; null pour un jeton personnel
  projectId      String?
  /// Étiquette d'environnement d'une clé (production, staging, development, test ou libre)
  environment    String?
  /// Propriétaire d'un jeton personnel ; null pour une clé de projet
  userId         String?
  /// Jeton personnel : tous les projets de son propriétaire (sinon : sélection AccessTokenProject)
  allProjects    Boolean   @default(false)
  /// Jeton personnel : accès à la bibliothèque de l'organisation
  includeLibrary Boolean   @default(false)
  /// Début lisible du jeton (ex. "sm_sk_4fQ9Zt"), affiché dans l'admin pour l'identifier
  prefix         String
  /// Empreinte SHA-256 du jeton ; le jeton en clair n'est montré qu'une fois, à sa création
  tokenHash      String    @unique
  /// Valeur en clair, uniquement pour une clé publique (non secrète, réaffichable)
  publicValue    String?
  /// Portées séparées par des espaces, à la manière d'OAuth (ex. "project:read media:read")
  scopes         String
  expiresAt      DateTime?
  lastUsedAt     DateTime?
  lastUsedIp     String?
  revokedAt      DateTime?
  /// Rotation : clé qui remplace celle-ci (l'ancienne reste valable jusqu'à expiresAt)
  replacedById   String?
  createdById    String?
  createdAt      DateTime  @default(now())

  project       Project?             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user          User?                @relation("AccessTokenOwner", fields: [userId], references: [id], onDelete: Cascade)
  createdBy     User?                @relation("AccessTokenCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  replacedBy    AccessToken?         @relation("AccessTokenRotation", fields: [replacedById], references: [id], onDelete: SetNull)
  replaces      AccessToken[]        @relation("AccessTokenRotation")
  projects      AccessTokenProject[]
  /// Médias envoyés par l'API avec cet identifiant (ou un jeton délégué qu'il a émis)
  uploadedMedia Media[]              @relation("MediaUploadedByToken")

  @@index([projectId])
  @@index([userId])
  @@index([replacedById])
}

/// Sélection de projets d'un jeton personnel (quand il ne couvre pas « tous mes projets »)
model AccessTokenProject {
  tokenId   String
  projectId String

  token   AccessToken @relation(fields: [tokenId], references: [id], onDelete: Cascade)
  project Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([tokenId, projectId])
  @@index([projectId])
}

/// Origine autorisée (CORS) à appeler l'API d'un projet depuis un navigateur
model AllowedOrigin {
  id        String   @id @default(cuid())
  projectId String
  /// Origine exacte : schéma + hôte + port éventuel, sans chemin (ex. "https://app.example.com")
  origin    String
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, origin])
}

/// Journal d'audit des actions sensibles (identifiants, membres, projets, visibilité, suppressions,
/// comptes). Volontairement sans clés étrangères : les entrées survivent aux comptes, projets et
/// jetons supprimés ; `data.label` garde un libellé lisible de la cible.
model AuditEvent {
  id          String   @id @default(cuid())
  at          DateTime @default(now())
  /// Utilisateur à l'origine de l'action (session d'administration)
  actorUserId String?
  /// Identifiant d'API à l'origine de l'action (API v1, à partir de B3)
  tokenId     String?
  projectId   String?
  /// Action normalisée, ex. "key.created", "member.removed" (shared/utils/audit.ts)
  action      String
  targetType  String?
  targetId    String?
  ipAddress   String?
  data        Json?

  @@index([projectId, at])
  @@index([actorUserId, at])
  @@index([at])
}

/// Envois consommés par un jeton délégué limité en nombre de fichiers (contrainte maxFiles) : le
/// jeton lui-même n'est pas stocké (signé, sans état) ; la ligne est purgée après son échéance.
model DelegatedTokenUsage {
  /// Identifiant unique du jeton délégué (champ jti de sa charge)
  jti       String   @id
  uploads   Int      @default(0)
  expiresAt DateTime

  @@index([expiresAt])
}

/// Compteur de révision d'un espace (« project:<id> », « library ») : incrémenté par toute écriture
/// de médias dans l'espace ; entre dans les ETag des listes de l'API (cache « générationnel »).
model CacheRevision {
  scope     String   @id
  revision  Int      @default(0)
  updatedAt DateTime @updatedAt
}

// ─── Médias ──────────────────────────────────────────────────────────────────

enum MediaKind {
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
  OTHER
}

enum Visibility {
  PUBLIC // diffusé sans authentification (dans la limite des règles CORS)
  PRIVATE // requiert un jeton d'accès ou une URL signée
}

/// Arborescence de dossiers d'un espace (unicité des noms par parent vérifiée par l'API)
model Folder {
  id        String   @id @default(cuid())
  /// Espace du dossier : un projet, ou null = bibliothèque de l'organisation
  projectId String?
  parentId  String?
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project  Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent   Folder?  @relation("FolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children Folder[] @relation("FolderTree")
  media    Media[]

  @@index([projectId, parentId])
}

/// Fichier original téléversé. Il appartient à un seul espace : un projet, ou la bibliothèque
/// de l'organisation (projectId null). Réutilisation ailleurs = duplication (copie indépendante).
model Media {
  id                String     @id @default(cuid())
  projectId         String?
  folderId          String?
  kind              MediaKind
  visibility        Visibility @default(PUBLIC)
  /// Clé opaque du fichier original dans le stockage (générée par le serveur, jamais exposée)
  storageKey        String     @unique
  /// Incrémentée à chaque remplacement du fichier : fait partie des URL de diffusion (cache immuable)
  version           Int        @default(1)
  originalName      String
  mimeType          String
  /// Taille en octets (entier 32 bits sous PostgreSQL/MySQL : 2 Gio maximum)
  size              Int
  /// Empreinte SHA-256 du contenu (détection des doublons)
  checksum          String
  width             Int?
  height            Int?
  /// Durée en secondes (vidéo, audio)
  duration          Float?
  title             String?
  /// Texte alternatif par défaut (accessibilité)
  altText           String?
  /// Colonnes de recherche : titre, nom d'origine et texte alternatif en minuscules sans accents
  /// (remplies par l'application, shared/utils/search.ts) — recherche identique sur les 3 bases
  searchTitle       String?
  searchName        String     @default("")
  searchAlt         String?
  /// Métadonnées techniques extraites à l'import (EXIF, profil colorimétrique…)
  metadata          Json?
  /// Point d'intérêt (0 à 1, origine en haut à gauche de l'image orientée) : recadrage « focal » des
  /// transformations ; le changer incrémente la version (architecture phase C, CD8)
  focalX            Float?
  focalY            Float?
  /// Image d'affiche d'une vidéo (phase D2) : fichier JPEG normalisé, source des dérivés de la vidéo
  /// (aperçu, transformations) ; la remplacer ou la retirer incrémente la version
  posterKey         String?    @unique
  posterWidth       Int?
  posterHeight      Int?
  posterSize        Int?
  /// Instant de la vidéo capturé (secondes), null pour une image envoyée
  posterTime        Float?
  /// Traitement de la vidéo par ffmpeg (phase D3) : en attente, en cours, prête, en échec ; null = non
  /// concerné (image, ou traitement inactif à l'envoi). Résumé de la dernière tâche (MediaJob), sans jointure
  processingState   ProcessingState?
  uploadedById      String?
  /// Identifiant d'API ayant envoyé le média (API v1 ; émetteur pour un jeton délégué)
  uploadedByTokenId String?
  /// Sujet final déclaré par l'application cliente dans un jeton délégué (audit), 128 caractères au plus
  uploadSubject     String?
  /// Média d'origine d'une copie créée par duplication
  duplicatedFromId  String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  /// Suppression logique (corbeille) ; null = média actif
  deletedAt         DateTime?

  /// Restrict : supprimer un projet exige de traiter ses médias avant (aucun fichier orphelin)
  project         Project?         @relation(fields: [projectId], references: [id], onDelete: Restrict)
  folder          Folder?          @relation(fields: [folderId], references: [id], onDelete: SetNull)
  uploadedBy      User?            @relation("MediaUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)
  uploadedByToken AccessToken?     @relation("MediaUploadedByToken", fields: [uploadedByTokenId], references: [id], onDelete: SetNull)
  duplicatedFrom  Media?           @relation("MediaDuplicates", fields: [duplicatedFromId], references: [id], onDelete: SetNull)
  duplicates      Media[]          @relation("MediaDuplicates")
  variants        MediaVariant[]
  textTracks      MediaTextTrack[]
  jobs            MediaJob[]
  renditions      MediaRendition[]
  tags            MediaTag[]

  @@index([projectId, deletedAt, createdAt])
  @@index([projectId, checksum])
  @@index([folderId])
  /// Corbeille, et liste « Tous les médias » triée par date sur plusieurs espaces (page « Médias » :
  /// 100 000 médias, 540 → 0 ms pour la première page ; .claude/architecture-media-view.md, MV14)
  @@index([deletedAt, createdAt])
  @@index([duplicatedFromId])
  @@index([uploadedByTokenId])
}

/// Étiquette des médias (architecture-tags.md) : globale (projectId null : bibliothèque et tous les
/// projets, gérée par un administrateur) ou propre à un projet (gérée par son propriétaire)
model Tag {
  id           String     @id @default(cuid())
  /// Projet de l'étiquette ; null = étiquette globale
  projectId    String?
  /// Libellé (1 à 64 caractères) ; unique sans casse ni accents parmi les étiquettes utilisables sur
  /// un même média (globales + projet) : vérifié par l'application
  name         String
  /// Clé d'unicité du nom (tagNameKey : minuscules, sans accents, espaces réduits), écrite avec le nom
  nameKey      String
  /// Identifiant lisible des filtres de l'API (TAG_SLUG_PATTERN), même unicité ; inchangé par un renommage
  slug         String
  /// Teinte de la palette (TAG_COLORS), validée par l'application
  color        String     @default("gray")
  /// Confidentielle : interface connectée seulement, comptes ayant `tags:confidential` ; jamais dans l'API v1
  confidential Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  project Project?   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  media   MediaTag[]

  @@index([projectId])
  @@index([nameKey])
  @@index([slug])
}

/// Étiquette affectée à un média (globale, ou du projet du média : vérifié par l'application)
model MediaTag {
  mediaId   String
  tagId     String
  createdAt DateTime @default(now())

  media Media @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  tag   Tag   @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([mediaId, tagId])
  @@index([tagId, mediaId])
}

/// Dérivé d'un média (crop, resize, optimisation…) généré à la demande puis mis en cache
model MediaVariant {
  id             String   @id @default(cuid())
  mediaId        String
  /// Transformation normalisée, dans un ordre canonique (ex. "c_fill,w_800,h_600,f_webp,q_80")
  transformation String
  /// Clé du fichier dérivé dans le stockage
  storageKey     String   @unique
  /// Format de sortie (webp, avif, jpeg, png…)
  format         String
  size           Int
  width          Int
  height         Int
  createdAt      DateTime @default(now())

  media Media @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([mediaId, transformation])
}

/// Type d'une piste de texte (élément HTML <track>) : sous-titres, sous-titres pour sourds et
/// malentendants, descriptions, chapitres
enum TextTrackKind {
  SUBTITLES
  CAPTIONS
  DESCRIPTIONS
  CHAPTERS
}

/// Piste de texte WebVTT d'une vidéo (phase D2). Fichier immuable (le remplacer crée une nouvelle
/// piste) ; type, langue, libellé et « par défaut » modifiables sans changer le fichier ni son URL.
model MediaTextTrack {
  id           String        @id @default(cuid())
  mediaId      String
  kind         TextTrackKind
  /// Langue (étiquette BCP 47 canonique : fr, en-GB, pt-BR…)
  language     String
  /// Libellé proposé par le lecteur (100 caractères au plus)
  label        String
  /// Piste choisie par défaut : une au plus par groupe (sous-titres, descriptions, chapitres)
  isDefault    Boolean       @default(false)
  /// Clé du fichier WebVTT normalisé (variants/<média>/track-<aléa>.vtt)
  storageKey   String        @unique
  size         Int
  checksum     String
  cueCount     Int
  /// Format envoyé : vtt, ou srt (converti en WebVTT)
  sourceFormat String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  media Media @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@index([mediaId])
}

/// État de traitement d'une vidéo, résumé sur le média (phase D3)
enum ProcessingState {
  PENDING
  PROCESSING
  READY
  FAILED
}

/// Statut d'une tâche de la file des traitements vidéo (phase D3)
enum MediaJobStatus {
  QUEUED
  RUNNING
  DONE
  FAILED
  CANCELLED
}

/// Tâche de la file persistante des traitements vidéo (phase D3, ffmpeg hors du chemin des requêtes) :
/// prise atomique par un processus de travail, bail renouvelé, reprise après un arrêt, essais limités.
model MediaJob {
  id          String         @id @default(cuid())
  mediaId     String
  /// Clé du fichier original visé : un autre fichier (remplacement, « Optimiser ») rend la tâche caduque ;
  /// un changement de version sans changement de fichier (affiche, point d'intérêt) ne la touche pas
  sourceKey   String
  status      MediaJobStatus @default(QUEUED)
  /// 0 = envoi récent ; négatif = traitement des vidéos existantes (passe après)
  priority    Int            @default(0)
  attempts    Int            @default(0)
  /// Reprise différée après un échec ou un arrêt
  runAfter    DateTime       @default(now())
  /// Processus qui exécute la tâche (hôte, pid, aléa ; 191 caractères au plus)
  lockedBy    String?
  /// Bail : une tâche dont le bail est échu revient dans la file
  leaseUntil  DateTime?
  /// Étape en cours (probe, sanitize, repair, transcode, av1, poster, verify)
  step        String?
  /// Avancement de l'étape (0–1), écrit au plus toutes les 5 s
  progress    Float?
  /// Étapes faites ou sautées, avertissements (JSON)
  result      Json?
  errorCode   String?
  /// Résumé de l'erreur (191 caractères au plus, jamais de chemin du serveur)
  errorDetail String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  startedAt   DateTime?
  finishedAt  DateTime?

  media Media @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@index([status, runAfter, priority])
  @@index([mediaId])
}

/// Rendu d'une vidéo produit par réencodage (phase D3) : H.264/AAC compatible, AV1 facultatif. Stocké
/// à côté de l'original (qui reste téléchargeable tel qu'envoyé) ; supprimé quand le fichier change.
model MediaRendition {
  id         String   @id @default(cuid())
  mediaId    String
  /// h264 | av1
  name       String
  /// mp4 | webm
  container  String
  mimeType   String
  /// Chaîne RFC 6381 (avc1.640028,mp4a.40.2)
  codecs     String
  width      Int
  height     Int
  duration   Float
  /// Débit moyen (bit/s)
  bitrate    Int
  size       Int
  checksum   String
  /// Clé du fichier (variants/<média>/rendition-<nom>-<aléa>.<ext>), indépendante de la version du média
  storageKey String   @unique
  createdAt  DateTime @default(now())

  media Media @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([mediaId, name])
}
