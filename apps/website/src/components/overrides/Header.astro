---
/**
 * Header: Starlight's own, plus a menu button on small screens for pages without a sidebar (landing,
 * pricing, FAQ). Below 50rem Starlight hides the header links (primary navigation, GitHub, theme,
 * language) and only shows them in the sidebar menu, which those pages do not have: without this
 * button, the main navigation was unreachable on a phone.
 *
 * The button is a disclosure (`aria-expanded`, `aria-controls`); the panel drops below the header and
 * closes with Escape, a click outside or a followed link.
 */
import Default from '@astrojs/starlight/components/Header.astro';
import MobileMenuFooter from '@astrojs/starlight/components/MobileMenuFooter.astro';
import { Icon } from '@astrojs/starlight/components';

const { hasSidebar } = Astro.locals.starlightRoute;
---

<div class="sm-header">
  <div class="sm-header-default"><Default /></div>
  {
    !hasSidebar && (
      <sm-site-menu class="md:sl-hidden print:hidden">
        <button
          type="button"
          class="sm-menu-button"
          aria-expanded="false"
          aria-controls="sm-site-menu-panel"
          aria-label={Astro.locals.t('menuButton.accessibleLabel')}
        >
          <Icon name="bars" class="open-menu" />
          <Icon name="close" class="close-menu" />
        </button>
        <div id="sm-site-menu-panel" class="sm-menu-panel" hidden>
          <MobileMenuFooter />
        </div>
      </sm-site-menu>
    )
  }
</div>

<script>
  class SiteMenu extends HTMLElement {
    constructor() {
      super();
      const button = this.querySelector('button')!;
      const panel = this.querySelector<HTMLElement>('.sm-menu-panel')!;
      const setOpen = (open: boolean) => {
        button.setAttribute('aria-expanded', String(open));
        panel.hidden = !open;
      };
      button.addEventListener('click', () => setOpen(button.getAttribute('aria-expanded') !== 'true'));
      this.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && button.getAttribute('aria-expanded') === 'true') {
          setOpen(false);
          button.focus();
        }
      });
      document.addEventListener('click', (event) => {
        if (!this.contains(event.target as Node)) setOpen(false);
      });
      panel.addEventListener('click', (event) => {
        if ((event.target as HTMLElement).closest('a')) setOpen(false);
      });
    }
  }
  customElements.define('sm-site-menu', SiteMenu);
</script>

<style>
  .sm-header {
    display: flex;
    align-items: center;
    gap: var(--sl-nav-gap);
    height: 100%;
  }

  .sm-header-default {
    flex: 1;
    min-width: 0;
    height: 100%;
  }

  .sm-menu-button {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    padding: 0.5rem;
    border: 0;
    border-radius: 0.5rem;
    background: var(--sl-color-bg-nav);
    color: var(--sl-color-white);
    cursor: pointer;
  }

  .sm-menu-button:focus-visible {
    outline: 2px solid var(--sl-color-text-accent);
    outline-offset: 2px;
  }

  .sm-menu-button :global(svg) {
    width: 1.5rem;
    height: 1.5rem;
  }

  .sm-menu-button[aria-expanded='true'] .open-menu,
  .sm-menu-button[aria-expanded='false'] .close-menu {
    display: none;
  }

  .sm-menu-panel {
    position: fixed;
    inset-inline: 0;
    top: var(--sl-nav-height);
    z-index: var(--sl-z-index-menu);
    padding: 0.5rem var(--sl-nav-pad-x) 1rem;
    border-bottom: 1px solid var(--sl-color-hairline-shade);
    background: var(--sl-color-bg-nav);
    box-shadow: var(--sl-shadow-md);
  }

  .sm-menu-panel[hidden] {
    display: none;
  }

  /* Primary links stacked, with comfortable touch targets. */
  .sm-menu-panel :global(.primary-nav) {
    flex-direction: column;
    align-items: stretch;
    gap: 0;
    width: 100%;
    margin: 0;
  }

  .sm-menu-panel :global(.primary-nav a) {
    padding-block: 0.75rem;
    font-size: var(--sl-text-base);
  }

  /* The panel has its own border: none above the first link. */
  .sm-menu-panel :global(.mobile-preferences) {
    border-top: 0;
  }

  .sm-menu-panel :global(.social-icons) {
    flex-wrap: wrap;
    width: 100%;
  }
</style>
