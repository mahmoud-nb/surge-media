---
/** Row of technologies the product runs on. */
interface Props {
  label: string;
  items: string[];
}

const { label, items } = Astro.props;
---

<div class="stack-strip not-content">
  <p>{label}</p>
  <ul>{items.map((item) => <li>{item}</li>)}</ul>
</div>

<style>
  .stack-strip {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    margin-block: 1rem 0;
    text-align: center;
  }

  p {
    margin: 0;
    color: var(--sm-muted);
    font-size: var(--sl-text-xs);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    padding: 0.375rem 0.875rem;
    border: 1px solid var(--sm-border);
    border-radius: 999px;
    background: var(--sm-surface);
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-sm);
    font-weight: 500;
  }
</style>
