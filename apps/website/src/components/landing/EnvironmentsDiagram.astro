---
/**
 * "One library, every environment": applications of each environment → one SurgeMedia instance →
 * the customer's own infrastructure. Plain lists, so it reads well without the layout.
 */
interface Props {
  caption: string;
  appsLabel: string;
  apps: { name: string; detail: string }[];
  hubLabel: string;
  hubItems: string[];
  infraLabel: string;
  infraItems: string[];
}

const { caption, appsLabel, apps, hubLabel, hubItems, infraLabel, infraItems } = Astro.props;
---

<figure class="diagram not-content">
  <div class="column apps">
    <p class="label">{appsLabel}</p>
    <ul>
      {
        apps.map(({ name, detail }) => (
          <li class="app">
            <span class="name">{name}</span>
            <span class="detail">{detail}</span>
          </li>
        ))
      }
    </ul>
  </div>
  <div class="link" aria-hidden="true"><span>API · /m/</span></div>
  <div class="column hub">
    <p class="label">{hubLabel}</p>
    <ul>{hubItems.map((item) => <li>{item}</li>)}</ul>
  </div>
  <div class="link" aria-hidden="true"><span>SQL · S3</span></div>
  <div class="column infra">
    <p class="label">{infraLabel}</p>
    <ul>{infraItems.map((item) => <li>{item}</li>)}</ul>
  </div>
  <figcaption>{caption}</figcaption>
</figure>

<style>
  .diagram {
    display: grid;
    gap: 0.75rem;
    margin: 0;
    padding: clamp(1rem, 3vw, 2rem);
    border: 1px solid var(--sm-border);
    border-radius: calc(var(--sm-radius) * 1.5);
    background: var(--sm-surface-raised);
  }

  @media (min-width: 56rem) {
    .diagram {
      grid-template-columns: 1fr auto 1.1fr auto 1fr;
      align-items: center;
    }
  }

  .column {
    padding: 1.25rem;
    border: 1px solid var(--sm-border);
    border-radius: var(--sm-radius);
    background: var(--sm-surface);
  }

  .hub {
    border-color: var(--sm-brand);
    box-shadow: 0 0 0 4px var(--sm-brand-soft);
  }

  .label {
    margin: 0 0 0.875rem;
    color: var(--sl-color-white);
    font-size: var(--sl-text-sm);
    font-weight: 650;
  }

  .hub .label {
    color: var(--sm-brand);
  }

  ul {
    display: grid;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    padding: 0.5rem 0.75rem;
    border-radius: 0.5rem;
    background: var(--sm-surface-raised);
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-sm);
  }

  .app {
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .app .name {
    font-weight: 600;
    color: var(--sl-color-white);
  }

  .app .detail {
    color: var(--sm-muted);
    font-family: var(--__sl-font-mono);
    font-size: var(--sl-text-xs);
  }

  .link {
    display: grid;
    place-items: center;
    color: var(--sm-muted);
    font-family: var(--__sl-font-mono);
    font-size: var(--sl-text-xs);
  }

  .link span::before {
    content: '↓ ';
  }

  @media (min-width: 56rem) {
    .link span::before {
      content: '';
    }

    .link span::after {
      content: ' →';
    }
  }

  figcaption {
    grid-column: 1 / -1;
    margin-top: 0.5rem;
    color: var(--sm-muted);
    font-size: var(--sl-text-sm);
    text-align: center;
  }
</style>
