{
  "name": "surge-media",
  "private": true,
  "type": "module",
  "description": "surgeMedia — plateforme auto-hébergée et modulaire de gestion et de traitement des médias.",
  "license": "MIT",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": "^22.12.0 || >=24.0.0",
    "pnpm": ">=12"
  },
  "scripts": {
    "dev": "pnpm --filter @surge-media/core dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "cli": "pnpm --filter @surge-media/core cli",
    "db:init": "pnpm --filter @surge-media/core db:init",
    "db:migrate": "pnpm --filter @surge-media/core db:migrate",
    "db:reset": "pnpm --filter @surge-media/core db:reset",
    "db:studio": "pnpm --filter @surge-media/core db:studio"
  }
}
