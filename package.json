{
  "name": "surge-media",
  "private": true,
  "type": "module",
  "description": "surgeMedia — plateforme auto-hébergée et modulaire de gestion et de traitement des médias.",
  "license": "BUSL-1.1",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": "^24.15.0 || >=26.0.0",
    "pnpm": ">=12"
  },
  "scripts": {
    "dev": "pnpm --filter @surge-media/core dev",
    "website:dev": "pnpm --filter @surge-media/website dev",
    "website:build": "pnpm --filter @surge-media/website build",
    "packages:build": "pnpm --filter \"./packages/*\" build",
    "packages:smoke": "node packages/scripts/check-release.mjs && node packages/scripts/pack-smoke.mjs",
    "playground:dev": "pnpm --filter @surge-media/playground dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "cli": "pnpm --filter @surge-media/core cli",
    "db:init": "pnpm --filter @surge-media/core db:init",
    "db:migrate": "pnpm --filter @surge-media/core db:migrate",
    "db:reset": "pnpm --filter @surge-media/core db:reset",
    "db:studio": "pnpm --filter @surge-media/core db:studio",
    "i18n:check": "pnpm --filter @surge-media/core i18n:check",
    "a11y:contrast": "pnpm -r a11y:contrast",
    "security:audit": "node security/audit.mjs",
    "security:test": "node --test security/audit.test.mjs",
    "lint": "pnpm -r lint",
    "lint:fix": "pnpm -r lint:fix",
    "release": "pnpm --filter @surge-media/core release",
    "release:dry": "pnpm --filter @surge-media/core release:dry",
    "release:libs": "release-it --config packages/.release-it.ts",
    "release:libs:dry": "release-it --config packages/.release-it.ts --dry-run",
    "changelog:libs": "release-it --config packages/.release-it.ts --changelog"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@release-it/conventional-changelog": "^12.0.2",
    "release-it": "^21.1.1",
    "simple-git-hooks": "^2.14.0"
  },
  "simple-git-hooks": {
    "commit-msg": "node_modules/.bin/commitlint --edit \"$1\""
  }
}
