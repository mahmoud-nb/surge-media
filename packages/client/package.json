{
  "name": "@surge-media/client",
  "version": "0.0.0",
  "type": "module",
  "description": "Framework-free TypeScript client for SurgeMedia: API v1, publishable keys and delegated tokens, responsive image and video URLs, shared component logic (texts, icons, inline styles) and an optional theme.",
  "keywords": [
    "surge-media",
    "media",
    "images",
    "video",
    "srcset",
    "api-client",
    "theme"
  ],
  "homepage": "https://github.com/mahmoud-nb/surge-media/tree/main/packages/client#readme",
  "bugs": {
    "url": "https://github.com/mahmoud-nb/surge-media/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mahmoud-nb/surge-media.git",
    "directory": "packages/client"
  },
  "license": "MIT",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./server": {
      "types": "./dist/server.d.mts",
      "import": "./dist/server.mjs"
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown && node scripts/build-css.mjs && publint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "a11y:contrast": "tsx scripts/check-contrast.ts"
  },
  "devDependencies": {
    "@nuxt/eslint-config": "1.17.0",
    "eslint": "^10.14.0",
    "publint": "^0.3.25",
    "tsdown": "^0.23.4",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5",
    "zod": "^4.6.7"
  }
}
