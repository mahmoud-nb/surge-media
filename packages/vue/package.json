{
  "name": "@surge-media/vue",
  "version": "0.0.0",
  "type": "module",
  "description": "Vue 3 components for SurgeMedia: responsive images, <picture>, videos with sources, posters and captions, file uploads with delegated tokens, processing status.",
  "keywords": [
    "surge-media",
    "vue",
    "components",
    "images",
    "video",
    "srcset",
    "accessibility"
  ],
  "homepage": "https://github.com/mahmoud-nb/surge-media/tree/main/packages/vue#readme",
  "bugs": {
    "url": "https://github.com/mahmoud-nb/surge-media/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mahmoud-nb/surge-media.git",
    "directory": "packages/vue"
  },
  "license": "MIT",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build && vue-tsc -p tsconfig.build.json && publint",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "dependencies": {
    "@surge-media/client": "workspace:*"
  },
  "devDependencies": {
    "@nuxt/eslint-config": "1.17.0",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.14.0",
    "happy-dom": "^21.0.4",
    "publint": "^0.3.25",
    "typescript": "~6.0.3",
    "vite": "8.3.5",
    "vitest": "^5.0.5",
    "vue": "3.5.44",
    "vue-tsc": "3.3.14"
  }
}
