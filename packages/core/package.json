{
  "name": "@surge-media/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Cœur de surgeMedia : interface d'administration, API médias et traitement d'images (Nuxt 3 + Nitro + Prisma).",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "prisma generate && nuxt dev",
    "build": "prisma generate && nuxt build && pnpm build:cli",
    "build:cli": "tsdown",
    "preview": "nuxt preview",
    "start": "node --env-file-if-exists=.env .output/server/index.mjs",
    "typecheck": "prisma generate && nuxt typecheck",
    "test": "vitest run",
    "postinstall": "nuxt prepare && prisma generate",
    "cli": "tsx cli/index.ts",
    "db:init": "tsx cli/index.ts init",
    "db:migrate": "tsx cli/index.ts db migrate",
    "db:reset": "tsx cli/index.ts db reset",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:migration": "tsx scripts/db-migration.ts",
    "i18n:check": "tsx scripts/i18n-check.ts",
    "a11y:contrast": "tsx scripts/check-contrast.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1141.0",
    "@aws-sdk/s3-request-presigner": "^3.1141.0",
    "@clack/prompts": "^1.8.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@lucide/vue": "^1.48.0",
    "@node-rs/argon2": "^2.2.1",
    "@nuxtjs/color-mode": "^4.0.1",
    "@nuxtjs/i18n": "^10.6.0",
    "@prisma/adapter-better-sqlite3": "7.10.0",
    "@prisma/adapter-mariadb": "7.10.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@tailwindcss/vite": "^4.3.3",
    "busboy": "^1.6.0",
    "citty": "^0.2.2",
    "clsx": "^2.1.1",
    "flydrive": "^2.1.0",
    "nuxt": "^3.21.11",
    "nuxt-auth-utils": "^0.5.30",
    "prisma": "7.10.0",
    "sharp": "^0.35.4",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/busboy": "^1.5.4",
    "@types/node": "^24.13.6",
    "tsdown": "^0.23.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.2",
    "vue-tsc": "^3.3.11"
  },
  "bin": {
    "surge-media": "./dist/cli/index.mjs"
  }
}
