# ─── surgeMedia · configuration ──────────────────────────────────────────────
# Copiez ce fichier en .env ou, mieux, lancez « pnpm db:init » qui le crée pour vous.

# Base de données : sqlite | postgresql | mysql (MySQL et MariaDB)
# Changer de fournisseur ? Utilisez « pnpm db:init » ou « pnpm db:reset » : le
# schéma Prisma et le client généré doivent suivre (ne modifiez pas seulement ce fichier).
DATABASE_PROVIDER="sqlite"
# SQLite     : file:./data/surge-media.db (chemin relatif au dossier packages/core)
# PostgreSQL : postgresql://utilisateur:motdepasse@localhost:5432/surge_media
# MySQL      : mysql://utilisateur:motdepasse@localhost:3306/surge_media
DATABASE_URL="file:./data/surge-media.db"

# ─── Installation ────────────────────────────────────────────────────────────
# URL publique de surgeMedia (demandée par « pnpm db:init »). Base des liens absolus vers
# les médias ; sans valeur, déduite de chaque requête (acceptable en développement seulement).
NUXT_SITE_URL="http://localhost:3000"
# Mandataires inverses de confiance (adresse IP réelle du client lue dans X-Forwarded-For : limites de
# débit, journal d'audit, sessions). « true » (défaut) : boucle locale et réseaux privés, dont ceux de
# Docker ; « false » : en-tête ignoré ; ou liste d'adresses et de plages CIDR, avec « loopback » et
# « private » (ex. "private,203.0.113.10"). Sans mandataire, ne laissez pas un réseau privé non maîtrisé
# joindre directement le serveur, ou mettez « false ».
# NUXT_TRUST_PROXY="true"

# ─── Médias ──────────────────────────────────────────────────────────────────
# Taille maximale d'une image envoyée, en octets (défaut : 26214400 = 25 Mio)
# NUXT_MEDIA_MAX_UPLOAD_SIZE="26214400"
# Taille maximale d'une vidéo envoyée, en octets (défaut : 536870912 = 512 Mio ; 2147483647 au plus)
# NUXT_MEDIA_MAX_VIDEO_UPLOAD_SIZE="536870912"
# Délai pour recevoir un envoi entier, en secondes (défaut : 3600). Node coupe sinon toute requête
# non reçue en 300 s. Un envoi sans aucune donnée pendant 60 s est arrêté dans tous les cas.
# NUXT_MEDIA_UPLOAD_TIMEOUT="3600"
# Préparation des vidéos MP4/MOV à l'envoi, sans réencodage : « faststart » (index en tête du fichier,
# lecture plus rapide), « metadata » (lieu de tournage et informations de l'appareil retirés), les deux
# (défaut) ou « none ».
# NUXT_MEDIA_VIDEO_PREPARE="faststart,metadata"
# Secret des liens temporaires vers les médias privés, généré par « pnpm db:init ».
# Le changer invalide tous les liens déjà partagés ; pour une rotation sans coupure, placez
# l'ancien secret dans NUXT_MEDIA_PREVIOUS_SIGNING_SECRET le temps que les liens expirent (7 j).
NUXT_MEDIA_SIGNING_SECRET=""
# NUXT_MEDIA_PREVIOUS_SIGNING_SECRET=""
# Base des adresses de diffusion (/m/…) si elle diffère de NUXT_SITE_URL : CDN, sous-domaine
# dédié (ex. https://cdn.example.com). Vide = NUXT_SITE_URL.
# NUXT_MEDIA_PUBLIC_URL=""
# Traitements d'images simultanés (analyse des envois, aperçus) : 0 = nombre de cœurs. Au-delà,
# les demandes attendent dans une file ; file pleine → 503 « serveur occupé » (Retry-After).
# NUXT_MEDIA_PROCESSING_CONCURRENCY="0"
# NUXT_MEDIA_PROCESSING_QUEUE="100"
# Transformations d'images à la demande (/m/<id>/v<n>/w_800,h_600/<nom>.webp) : dimension de
# sortie maximale, formats activés, dérivés par version de média (au-delà : plus de nouveaux
# paramètres libres), nouvelles générations libres non signées par IP et par minute (0 = sans
# limite ; derrière un CDN, toutes les requêtes viennent de quelques adresses : relever ou mettre 0).
# NUXT_MEDIA_TRANSFORM_MAX_DIMENSION="4096"
# NUXT_MEDIA_TRANSFORM_FORMATS="jpg,png,webp,avif"
# NUXT_MEDIA_TRANSFORM_MAX_VARIANTS="50"
# NUXT_MEDIA_TRANSFORM_RATE_LIMIT="60"
# Cache (secondes) des URL d'un préréglage global ou de projet : modifiable, donc revalidé (7 jours).
# NUXT_MEDIA_TRANSFORM_PRESET_MAX_AGE="604800"

# Stockage physique : local (disque du serveur) | s3 (AWS S3 ou service compatible :
# Cloudflare R2, MinIO, Scaleway, OVH, Backblaze B2…). Changer de stockage ne modifie
# ni les API ni les données : copiez les fichiers existants vers le nouvel emplacement.
NUXT_MEDIA_STORAGE_DRIVER="local"
# Pilote local : dossier racine (relatif à packages/core ou absolu, ex. /var/lib/surge-media)
NUXT_MEDIA_STORAGE_ROOT="./data/media"
# Préfixe de toutes les clés (partage d'un bucket entre plusieurs instances), ex. "prod/"
# NUXT_MEDIA_STORAGE_PREFIX=""
# Pilote s3 :
# NUXT_MEDIA_STORAGE_S3_BUCKET=""
# NUXT_MEDIA_STORAGE_S3_REGION="eu-west-3"          # « auto » pour Cloudflare R2
# NUXT_MEDIA_STORAGE_S3_ENDPOINT=""                 # vide pour AWS, ex. https://<compte>.r2.cloudflarestorage.com
# NUXT_MEDIA_STORAGE_S3_ACCESS_KEY_ID=""
# NUXT_MEDIA_STORAGE_S3_SECRET_ACCESS_KEY=""
# NUXT_MEDIA_STORAGE_S3_FORCE_PATH_STYLE="false"    # "true" pour MinIO

# ─── Traitement des vidéos (ffmpeg) ──────────────────────────────────────────
# Facultatif. ffmpeg et ffprobe du système (version 6 ou plus, encodeurs libx264 et aac ; paquets :
# « apt install ffmpeg », « winget install Gyan.FFmpeg »). Avec le traitement actif : retrait des
# pistes GPS des appareils, réparation des WebM des navigateurs, affiche extraite quand il n'y en a pas,
# version compatible H.264 quand elle sert (HEVC, 4K, HDR…), MKV, AVI, 3GP, MPEG-TS, OGV et WMV acceptés
# puis convertis. Vérifié au démarrage : en cas de problème, traitement désactivé avec un message.
# Mode : off (défaut, aucun traitement) | embedded (le serveur web exécute les tâches, ffmpeg en
# priorité la plus basse) | external (processus de travail séparés : « surge-media worker », ou
# NUXT_SERVER_ROLE=worker ; même base et même stockage que le serveur web).
# NUXT_VIDEO_PROCESSING="off"
# Rôle du processus : web (défaut) | worker (exécute les tâches, ne sert que /api/health).
# NUXT_SERVER_ROLE="web"
# Binaires (défaut : ceux du PATH) :
# NUXT_FFMPEG_PATH="ffmpeg"
# NUXT_FFPROBE_PATH="ffprobe"
# NUXT_VIDEO_CONCURRENCY="1"          # tâches simultanées par processus (un encodage 1080p : 0,4 à 0,75 Gio)
# NUXT_VIDEO_THREADS="0"              # fils par ffmpeg, 0 = moitié des cœurs (16 au plus)
# NUXT_VIDEO_RENDITION="auto"         # version H.264 : auto (seulement si elle sert) | always | never (sauf formats convertis)
# NUXT_VIDEO_PRESET="veryfast"        # préréglage x264 (medium : 1,7 × plus long, fichier plus petit)
# NUXT_VIDEO_CRF="23"                 # qualité x264, 0 à 51 (plus bas = meilleure qualité, plus lourd)
# NUXT_VIDEO_AV1="off"                # version AV1 en plus (libsvtav1 et libopus exigés), on | off
# NUXT_VIDEO_MAX_DURATION="10800"     # secondes ; au-delà, pas de conversion (échec « trop longue »)
# NUXT_VIDEO_MEMORY_LIMIT="4096"      # Mio par ffmpeg (Linux, prlimit), 0 = sans limite
# Espace temporaire : environ la taille de l'original (copie depuis S3) plus les sorties, par tâche
# simultanée, dans le dossier temporaire du système (TMPDIR). NUXT_MEDIA_PROCESSING_* ne concerne
# que les images.

# ─── API publique v1 (/api/v1) ───────────────────────────────────────────────
# Requêtes par minute (en mémoire du processus : à partager via Redis en multi-instances).
# NUXT_API_RATE_LIMIT_PUBLISHABLE="300"      # par clé publique et par adresse IP
# NUXT_API_RATE_LIMIT_SECRET="1200"          # par clé secrète
# NUXT_API_RATE_LIMIT_PERSONAL="1200"        # par jeton personnel
# NUXT_API_RATE_LIMIT_DELEGATED="300"        # jetons délégués : par émetteur et par adresse IP
# NUXT_API_RATE_LIMIT_UPLOADS="60"           # envois de fichiers par identifiant (en plus des limites ci-dessus)
# NUXT_API_RATE_LIMIT_AUTH_FAILURES="30"     # identifiants refusés par adresse IP

# ─── Sessions de l'administration (nuxt-auth-utils) ─────────────────────────
# Secret de chiffrement des cookies (32 caractères minimum), généré par « pnpm db:init ».
# Le changer déconnecte tout le monde.
NUXT_SESSION_PASSWORD=""
# Durée d'une session en secondes (défaut : 43200 = 12 h)
# NUXT_SESSION_MAX_AGE="43200"
# Appareils de confiance : jours pendant lesquels un navigateur coché « Faire confiance à cet
# appareil » ne redemande plus le mot de passe pour les actions sensibles (défaut : 15, 365 au
# plus). 0 désactive l'option et ignore les appareils déjà de confiance.
# NUXT_PUBLIC_TRUSTED_DEVICE_DAYS="15"

# ─── Envoi d'e-mails (SMTP) ─────────────────────────────────────────────────
# Facultatif. Avec un hôte et un expéditeur, les liens d'invitation et de réinitialisation
# peuvent être envoyés par e-mail depuis l'administration (bouton « Envoyer par e-mail »,
# toujours à l'adresse du compte). Sans eux, le lien se transmet à la main. Redémarrer après
# un changement.
# NUXT_SMTP_HOST="smtp.example.com"
# NUXT_SMTP_PORT="587"                        # 587 (STARTTLS) ou 465 avec NUXT_SMTP_SECURE="true"
# NUXT_SMTP_SECURE="false"
# NUXT_SMTP_USER=""
# NUXT_SMTP_PASSWORD=""
# NUXT_SMTP_FROM="surgeMedia <no-reply@example.com>"

# ─── Première connexion (compte d'amorçage) ─────────────────────────────────
# Tant qu'aucun utilisateur n'existe, ces identifiants permettent la première
# connexion, qui crée le compte ADMIN en base. Supprimez-les ensuite : ils sont
# alors ignorés et le tableau de bord le signale.
# Mot de passe : 12 caractères minimum.
NUXT_BOOTSTRAP_ADMIN_EMAIL=""
NUXT_BOOTSTRAP_ADMIN_PASSWORD=""
