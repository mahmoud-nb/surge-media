# ─── surgeMedia · configuration ──────────────────────────────────────────────
# Copiez ce fichier en .env ou, mieux, lancez « pnpm db:init » qui le crée pour vous.

# Base de données : sqlite | postgresql | mysql (MySQL et MariaDB)
# Changer de fournisseur ? Utilisez « pnpm db:init » ou « pnpm db:reset » : le
# schéma Prisma et le client généré doivent suivre (ne modifiez pas seulement ce fichier).
DATABASE_PROVIDER="sqlite"
# SQLite     : file:./data/surge-media.db (chemin relatif au dossier packages/core)
# PostgreSQL : postgresql://utilisateur:motdepasse@localhost:5432/surge_media
# MySQL      : mysql://utilisateur:motdepasse@localhost:3306/surge_media
DATABASE_URL="file:./data/surge-media.db"

# Stockage des fichiers (unstorage, pilote « fs ») : dossier des originaux et dérivés
NUXT_STORAGE_BASE="./data/media"
