# ─── surgeMedia · configuration ──────────────────────────────────────────────
# Copiez ce fichier en .env ou, mieux, lancez « pnpm db:init » qui le crée pour vous.

# Base de données : sqlite | postgresql | mysql (MySQL et MariaDB)
# Changer de fournisseur ? Utilisez « pnpm db:init » ou « pnpm db:reset » : le
# schéma Prisma et le client généré doivent suivre (ne modifiez pas seulement ce fichier).
DATABASE_PROVIDER="sqlite"
# SQLite     : file:./data/surge-media.db (chemin relatif au dossier packages/core)
# PostgreSQL : postgresql://utilisateur:motdepasse@localhost:5432/surge_media
# MySQL      : mysql://utilisateur:motdepasse@localhost:3306/surge_media
DATABASE_URL="file:./data/surge-media.db"

# ─── Installation ────────────────────────────────────────────────────────────
# URL publique de surgeMedia (demandée par « pnpm db:init »). Base des liens absolus vers
# les médias ; sans valeur, déduite de chaque requête (acceptable en développement seulement).
NUXT_SITE_URL="http://localhost:3000"

# ─── Médias ──────────────────────────────────────────────────────────────────
# Taille maximale d'un fichier envoyé, en octets (défaut : 26214400 = 25 Mio)
# NUXT_MEDIA_MAX_UPLOAD_SIZE="26214400"
# Secret des liens temporaires vers les médias privés, généré par « pnpm db:init ».
# Le changer invalide tous les liens déjà partagés ; pour une rotation sans coupure, placez
# l'ancien secret dans NUXT_MEDIA_PREVIOUS_SIGNING_SECRET le temps que les liens expirent (7 j).
NUXT_MEDIA_SIGNING_SECRET=""
# NUXT_MEDIA_PREVIOUS_SIGNING_SECRET=""
# Base des adresses de diffusion (/m/…) si elle diffère de NUXT_SITE_URL : CDN, sous-domaine
# dédié (ex. https://cdn.example.com). Vide = NUXT_SITE_URL.
# NUXT_MEDIA_PUBLIC_URL=""

# Stockage physique : local (disque du serveur) | s3 (AWS S3 ou service compatible :
# Cloudflare R2, MinIO, Scaleway, OVH, Backblaze B2…). Changer de stockage ne modifie
# ni les API ni les données : copiez les fichiers existants vers le nouvel emplacement.
NUXT_MEDIA_STORAGE_DRIVER="local"
# Pilote local : dossier racine (relatif à packages/core ou absolu, ex. /var/lib/surge-media)
NUXT_MEDIA_STORAGE_ROOT="./data/media"
# Préfixe de toutes les clés (partage d'un bucket entre plusieurs instances), ex. "prod/"
# NUXT_MEDIA_STORAGE_PREFIX=""
# Pilote s3 :
# NUXT_MEDIA_STORAGE_S3_BUCKET=""
# NUXT_MEDIA_STORAGE_S3_REGION="eu-west-3"          # « auto » pour Cloudflare R2
# NUXT_MEDIA_STORAGE_S3_ENDPOINT=""                 # vide pour AWS, ex. https://<compte>.r2.cloudflarestorage.com
# NUXT_MEDIA_STORAGE_S3_ACCESS_KEY_ID=""
# NUXT_MEDIA_STORAGE_S3_SECRET_ACCESS_KEY=""
# NUXT_MEDIA_STORAGE_S3_FORCE_PATH_STYLE="false"    # "true" pour MinIO

# ─── API publique v1 (/api/v1) ───────────────────────────────────────────────
# Requêtes par minute (en mémoire du processus : à partager via Redis en multi-instances).
# NUXT_API_RATE_LIMIT_PUBLISHABLE="300"      # par clé publique et par adresse IP
# NUXT_API_RATE_LIMIT_SECRET="1200"          # par clé secrète
# NUXT_API_RATE_LIMIT_PERSONAL="1200"        # par jeton personnel
# NUXT_API_RATE_LIMIT_AUTH_FAILURES="30"     # identifiants refusés par adresse IP

# ─── Sessions de l'administration (nuxt-auth-utils) ─────────────────────────
# Secret de chiffrement des cookies (32 caractères minimum), généré par « pnpm db:init ».
# Le changer déconnecte tout le monde.
NUXT_SESSION_PASSWORD=""
# Durée d'une session en secondes (défaut : 43200 = 12 h)
# NUXT_SESSION_MAX_AGE="43200"

# ─── Première connexion (compte d'amorçage) ─────────────────────────────────
# Tant qu'aucun utilisateur n'existe, ces identifiants permettent la première
# connexion, qui crée le compte ADMIN en base. Supprimez-les ensuite : ils sont
# alors ignorés et le tableau de bord le signale.
# Mot de passe : 12 caractères minimum.
NUXT_BOOTSTRAP_ADMIN_EMAIL=""
NUXT_BOOTSTRAP_ADMIN_PASSWORD=""
